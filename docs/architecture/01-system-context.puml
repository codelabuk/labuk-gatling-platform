@startuml 01-system-context
!include _theme.iuml
title labuk-gatling - system context
left to right direction

actor "Perf tester / QA\nbrowser only" as tester
actor "CI pipeline / GitOps\nJenkins, GitLab, Argo CD" as ci
actor "Framework developer" as dev
database "Git repo (optional)\nfor CI / GitOps runs" as git <<input>>

node "Developer machine / CI agent" <<local>> {
  component "perf CLI\nvalidate | run | submit | status | fetch | convert-lr" as cli <<code>>
}

cloud "Kubernetes cluster (on-prem)" {
  component "Ingress (nginx, TLS)\nperf-dashboard.codelabuk.dev" as ingress <<ctrl>>
  package "namespace: perf" <<ns>> {
    component "perf-dashboard\nRuns, New run, Test plans, History" as dashboard <<ctrl>>
    component "loadtest-operator\n2 replicas, leader election" as operator <<ctrl>>
    collections "LoadTest\nperf.codelabuk.org/v1alpha1" as crd <<ctrl>>
    package "Jobs of one run" <<run>> {
      component "validate\nfetches suite, keeps a copy" as validate <<run>>
      component "setup (once)" as setup <<run>>
      component "workers x N\nIndexed Job, /metrics :9464" as workers <<run>>
      component "report (merge)" as report <<run>>
    }
  }
  package "namespace: minio" <<store>> {
    database "MinIO / S3 bucket perf-results\ntest-plans/ (suites) + runs/ (results)" as minio <<store>>
  }
  component "Prometheus + Grafana\n(optional)" as prom <<obs>>
}

package "Systems under test" <<sut>> {
  component "HTTP / REST APIs" as apis <<sut>>
  database "Databases\nOracle, PostgreSQL, ... (JDBC)" as dbs <<sut>>
  database "Arrow Flight servers\ne.g. labukDB" as flightsrv <<sut>>
}

' control
tester -[#2F6FD6,bold]-> ingress : browser, HTTPS: test plans,\nruns, live view, reports
ingress -[#2F6FD6]-> dashboard
dev -[#2F6FD6]-> cli
ci -[#2F6FD6]-> cli
dev -[#5B6B7F,dashed]-> crd : mvn install, docker build, helm
cli -[#2F6FD6]-> crd : kubectl: LoadTest
dashboard -[#2F6FD6]-> crd : create / list / delete
operator -[#2F6FD6]-> crd : watches
operator -[#2F6FD6]-> validate : creates Jobs,\nreads results
operator -[#2F6FD6]-> setup
operator -[#2F6FD6]-> workers
operator -[#2F6FD6]-> report
validate -[#B59F3B,dashed]-> git : or clone (CI / GitOps)

' test files and results
dashboard -[#B59F3B,bold]-> minio : suites: upload, edit, delete
validate -[#B59F3B]-> minio : suite -> run's tests copy
setup -[#D98E04]-> minio : tests copy, shared.json
workers -[#D98E04]-> minio : tests copy, logs + summaries
report -[#D98E04]-> minio : report + summary.json
dashboard -[#D98E04]-> minio : results: read, delete
cli -[#D98E04]-> minio : perf fetch

' load
cli -[#C0392B,bold]-> apis : perf run (local debug load)
workers -[#C0392B,bold]-> apis : load
workers -[#C0392B,bold]-> dbs : load
workers -[#C0392B,bold]-> flightsrv : load (gRPC)

' live metrics
dashboard -[#17A2B8,dashed]-> workers : live metrics
prom -[#17A2B8,dashed]-> workers : scrape

legend right
  <b>Colour key</b>
  |<#E3EEFF> control plane |<#2F6FD6><color:#FFFFFF> control </color>|
  |<#E3F6E8> run pods |<#C0392B><color:#FFFFFF> load </color>|
  |<#FFF3D9> results / storage |<#D98E04><color:#FFFFFF> results data </color>|
  |<#FDE7E7> systems under test |<#17A2B8><color:#FFFFFF> live metrics </color>|
  |<#FFFBEA> test files |<#B59F3B><color:#FFFFFF> test files </color>|
  |<#E0F5F7> observability |<#5B6B7F><color:#FFFFFF> build / deploy </color>|
endlegend
@enduml
