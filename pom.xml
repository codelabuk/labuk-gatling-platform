<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.codelabuk</groupId>
    <artifactId>labuk-gatling</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>gatling-api-core</module>
        <module>gatling-sql</module>
        <module>gatling-flight</module>
        <module>gatling-runner</module>
        <module>loadtest-operator</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Gatling's logback 1.5 needs SLF4J 2.x; libraries such as HikariCP pull in 1.7.x, which silently
                 disables all logging (SLF4J falls back to a no-op logger) - pin it for every module -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.16</version>
            </dependency>
            <!-- One Netty for everything: Gatling's (4.1.115). Arrow Flight would otherwise add 4.1.100 / 4.1.108 next to
                 it, and Netty modules must all be the same version. -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>4.1.115.Final</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Arrow Flight 16.1.0 comes with gRPC 1.63 (built for Netty 4.1.100); on Netty 4.1.115 its HTTP/2 streams
                 broke ("http2 exception", "end-of-stream mid-frame"). gRPC 1.76 works with Gatling's Netty. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>1.76.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>